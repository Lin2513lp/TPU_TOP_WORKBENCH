# Functional-mode CDC intent. Units: ns. No CDC paths are waived.
current_design tpu_top
# Different domains deliberately model AHB and SYS as asynchronous.
clock -name sys_clk -domain SYS -period 2.5 -edge {0 1.25}
clock -name ahb_clk -domain AHB -period 10 -edge {0 5}
# sys_ckg and all pe_ckg gates are traced back to sys_clk by SpyGlass.
reset -name sys_rst_n -value 0
set_case_analysis -name dft_mode -value 0
set_case_analysis -name dft_glb_gt_se -value 0
set_case_analysis -name dft_lgc_rst_n -value 1

# AHB host is synchronous to ahb_clk.
input -name hsel -clock ahb_clk
input -name hsize -clock ahb_clk
input -name haddr -clock ahb_clk
input -name hburst -clock ahb_clk
input -name htrans -clock ahb_clk
input -name hwrite -clock ahb_clk
input -name hwdata -clock ahb_clk
input -name hreadyin -clock ahb_clk
input -name hprot -clock ahb_clk
output -name hready -clock ahb_clk
output -name hrdata -clock ahb_clk
output -name hresp -clock ahb_clk

# Existing AXI wrappers contain SINGLE-clock FIFOs. External stream logic
# must be synchronous to SYS and satisfy timing/hold requirements at the
# active sys_ckg edges; an independent external clock requires an async FIFO.
input -name rd_tvalid -clock sys_clk
input -name rd_tdata -clock sys_clk
input -name rd_tkeep -clock sys_clk
input -name rd_tstrb -clock sys_clk
input -name rd_tlast -clock sys_clk
input -name rd_tid -clock sys_clk
input -name rd_tdest -clock sys_clk
input -name rd_tuser -clock sys_clk
input -name wr_tready -clock sys_clk
output -name rd_tready -clock sys_clk
output -name wr_tvalid -clock sys_clk
output -name wr_tdata -clock sys_clk
output -name wr_tkeep -clock sys_clk
output -name wr_tstrb -clock sys_clk
output -name wr_tlast -clock sys_clk
output -name wr_tid -clock sys_clk
output -name wr_tdest -clock sys_clk
output -name wr_tuser -clock sys_clk

# Intentionally no quasi_static on H/W/mode, no false paths on mailboxes,
# and no forced constants on CRG enable/bypass. Review those real crossings.
